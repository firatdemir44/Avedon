generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// accountType: "konfeksiyon" | "uretici" | "bireysel"
// verification: "dogrulanmamis" | "inceleniyor" | "dogrulanmis"
// product.type: "raschel" | "orme" | "dokuma" | "diger"
// sampleRequest.status: "talep_edildi" | "onaylandi" | "hazirlandi" | "teslim_edildi"
//   Son adımın ETİKETİ teslimat moduna göre değişir ("Teslim Edildi" / "Kurye
//   Teslim Aldı") ama STATÜ tektir — mod zaten deliveryMode'da saklı, ayrıca
//   statü olarak tutulsa iki alan birbiriyle çelişebilirdi.
// sampleRequest.deliveryMode: "seller_ships" | "customer_courier"
// post.visibility: "public" | "connections"
// video.status: "uploading" | "processing" | "ready" | "error"
// Enums are modeled as plain strings because the sqlite connector has no native enum type;
// valid values are enforced at the API layer with zod.

model Company {
  id                String    @id @default(cuid())
  name              String
  taxId             String
  about             String    @default("")
  contactEmail      String    @default("")
  contactPhone      String    @default("")
  productCategories String    @default("")
  // Firma sayfası "Şirket Genel Bakışı" (Aşama B). companyType anahtarları
  // src/catalog.ts COMPANY_TYPES; boş = belirtilmemiş. Ürün grupları ayrı alan
  // değil, firmanın ürünlerinden hesaplanıyor.
  companyType       String    @default("")
  foundedYear       Int?
  website           String    @default("")
  city              String    @default("")
  district          String    @default("")
  address           String    @default("")
  mainMarkets       String    @default("")
  verification      String    @default("dogrulanmamis")
  // Faz 2 Adım 7: doğrulamanın nasıl yapıldığı: "" | belge (vergi levhası/ticaret sicil) | ziyaret (yerinde ziyaret)
  verificationLevel String    @default("")
  verifiedAt        DateTime?
  companyCode       String    @unique
  // Logonun kendisi CompanyLogo'da. Burada yalnızca son değişme zamanı var:
  // istemci "logo var mı" bilgisini ve önbellek anahtarını buradan alır.
  // Faz 2 Adım 5: fason kapasite ağı. Aylık tonaj firmanın BEYANIDIR (Fırat 2026-09-17).
  monthlyCapacityTons   Float?
  capacityNote          String    @default("")
  // Fason (dışarıya) kapasite açık mı
  contractOpen          Boolean   @default(false)
  capacityUpdatedAt     DateTime?
  logoUpdatedAt     DateTime?
  createdAt         DateTime  @default(now())
  users             User[]
  products          Product[]
  logo              CompanyLogo?
  photos            CompanyPhoto[]
  assistantThreads  AssistantThread[]
  memories          CompanyMemory[]
  faqs              CompanyFaq[]
  machines          Machine[]
  referencesGiven   CompanyReference[] @relation("ReferenceFrom")
  referencesReceived CompanyReference[] @relation("ReferenceTo")
  questions         CompanyQuestion[]
}

// Firma sayfasındaki galeriler (Aşama B): kind "office" (ofis/üretim
// fotoğrafları) veya "certificate" (sertifika, başarı belgesi). Sıralar her
// zaman 0..n-1 sıkışık (bkz. replaceCompanyPhotos). imageUrl base64 data URL;
// liste yanıtlarında dönmez, tek tek uçtan çekilir.
model CompanyPhoto {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind      String
  position  Int
  imageUrl  String
  createdAt DateTime @default(now())

  @@unique([companyId, kind, position])
}

// Firma logosu (base64 data URL) ayrı tabloda: giriş yanıtı, kullanıcı profili
// ve firma araması firmayı `include: { company: true }` ile çekiyor; logo
// Company'de olsaydı her birinde gereksiz yere taşınırdı. Yalnızca
// GET /api/companies/:id/logo döner.
model CompanyLogo {
  companyId String   @id
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  imageUrl  String
  updatedAt DateTime @updatedAt
}

model User {
  id                   String          @id @default(cuid())
  accountType          String
  position             String
  firstName            String
  lastName             String
  phone                String          @unique
  phoneVerified        Boolean         @default(false)
  // Asistan kişiliği: "" (seçilmedi) | ipek | mert (assistant/persona.ts).
  assistantPersona     String          @default("")
  isAdmin              Boolean         @default(false)
  // Kişisel profil fotoğrafı (Fırat 2026-09-21). Fotoğrafın kendisi UserAvatar'da; burada yalnızca
  // "var mı / ne zaman değişti" bilgisi (istemci önbellek anahtarı; firma logosuyla aynı desen).
  avatarUpdatedAt      DateTime?
  avatar               UserAvatar?
  companyId            String?
  company              Company?        @relation(fields: [companyId], references: [id])
  sampleRequests       SampleRequest[]
  sentConnections      Connection[]    @relation("ConnectionRequester")
  receivedConnections  Connection[]    @relation("ConnectionAddressee")
  conversationsAsUserA Conversation[]  @relation("ConversationUserA")
  conversationsAsUserB Conversation[]  @relation("ConversationUserB")
  messages             Message[]
  posts                Post[]
  postLikes            PostLike[]
  postComments         PostComment[]
  sampleRequestEvents  SampleRequestEvent[]
  videos               Video[]
  productFavorites     ProductFavorite[]
  productViews         ProductView[]
  assistantThreads     AssistantThread[]
  whatsAppInbounds     WhatsAppInbound[]
  notifications        Notification[]
  watchRules           WatchRule[]
  quoteRequests        QuoteRequest[]
  quotes               Quote[]
  companyQuestions     CompanyQuestion[]
  createdAt            DateTime        @default(now())
}

// Katalog anahtarları (type, subtype, usages) src/catalog.ts'te tanımlı ve API'de
// doğrulanıyor. type: "orme" | "raschel" | "dokuma" | "dantel" | "triko" | "diger".
model Product {
  id             String          @id @default(cuid())
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id])
  code           String
  type           String
  // Alt çeşit anahtarı (ör. "suprem"); boş = belirtilmemiş.
  subtype        String          @default("")
  // Kullanım amaçları: JSON dizi metni, ör. ["pantolonluk","taytlik"].
  usages         String          @default("[]")
  // Float: form "220,5" gibi ondalık kabul ediyor; Int iken sunucu 201 dönüp
  // değeri sessizce 220'ye kesiyordu.
  stock          Float
  // "m" | "kg"
  stockUnit      String          @default("m")
  weightGsm      Float
  widthCm        Float
  content        String
  // Serbest kullanım notu (isteğe bağlı); etiketler usages'ta.
  useArea        String          @default("")
  // --- Kumaş pasaportu (Faz 1, Adım 2; docs/faz1-plani.md) ---
  // Hepsi isteğe bağlı; eski istemciler bu alanlar olmadan çalışır.
  // widthType: "" | acik | tup
  widthType         String    @default("")
  // Enin anlamı (Fırat 2026-09-16): "" | acik (girilen en açık en) | tup_tek_yuz (tek yüz tüp eni;
  // hesap eni iki katı). Otomatik çarpma yok, satıcı seçer.
  widthMeaning      String    @default("")
  // MOQ değeri ve birimi stok biriminden bağımsız (kullanıcı kararı 2026-09-16).
  moq               Float?
  moqUnit           String    @default("")
  leadTimeDays      Int?
  // Fiyat yalnızca ürünün sahibi firmaya döner (API katmanı süzer).
  priceValue        Float?
  priceCurrency     String    @default("")
  priceUnit         String    @default("")
  // Boya/apre etiketleri: JSON dizi metni (usages ile aynı desen).
  finishTags        String    @default("[]")
  passportUpdatedAt DateTime?
  // Faz 3 Adım 7: AB Dijital Ürün Pasaportu'na HAZIRLIK alanları (hepsi isteğe bağlı).
  originCountry     String    @default("")
  careNotes         String    @default("")
  // Bakım sembolleri: JSON dizi metni (domain/care.ts anahtarları; grup başına en çok bir sembol).
  careSymbols       String    @default("[]")
  recycledPercent   Float?
  compositions      ProductComposition[]
  yarns             ProductYarn[]
  certificates      ProductCertificate[]
  testReports       ProductTestReport[]
  fieldMeta         ProductFieldMeta[]
  images         ProductImage[]
  favorites      ProductFavorite[]
  views          ProductView[]
  sampleRequests SampleRequest[]
  quoteRequests  QuoteRequest[]
  posts          Post[]
  // Faz 2 Adım 6: type = "iplik" olan ürünün ipliğe özel alanları.
  yarnSpec       YarnSpec?
  // Faz 3 Adım 3: kapak fotoğrafından çıkarılan görünüm kartı (benzer kumaş arama).
  look           ProductLook?
  createdAt      DateTime        @default(now())
}

// Kumaş pasaportu alt tabloları (Faz 1, Adım 2). Kompozisyon doğruluk
// kaynağıdır; Product.content metni kompozisyon varsa sunucuda ondan üretilir.
// Sıralar (position) her zaman 0..n-1 sıkışık (replacePassportRelations).
model ProductComposition {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  position  Int
  // Lif anahtarı (src/domain/glossary/fibers.ts)
  fiber     String
  percent   Float

  @@unique([productId, position])
  @@index([fiber, percent])
}

// role: "" | ana | ilave | ekstra · unit: ne | nm | tex | dtex | denye
// yarnType: catalog.ts YARN_TYPES anahtarı ya da boş
model ProductYarn {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  position  Int
  role      String  @default("")
  count     Float
  unit      String
  ply       Int     @default(1)
  yarnType  String  @default("")

  @@unique([productId, position])
}

// name: sertifika anahtarı (src/domain/glossary/certificates.ts). Belge
// fotoğrafı isteğe bağlı; liste yanıtlarında dönmez, ayrı uçtan çekilir.
model ProductCertificate {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  position   Int
  name       String
  number     String    @default("")
  validUntil DateTime?
  imageUrl   String?

  @@unique([productId, position])
  @@index([name])
}

// Test raporu üstverisi; Faz 1'de belge yalnızca isteğe bağlı fotoğraf.
model ProductTestReport {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  position  Int
  kind      String
  result    String    @default("")
  testedAt  DateTime?
  imageUrl  String?

  @@unique([productId, position])
}

// "Her alan değer + güven + kaynak taşır" (yol haritası §4). Yalnızca çıkarım
// ya da ayrıştırma ile gelen alanlar satır alır; elle girilen alan = güven 1,
// kaynak manual, satır yok. source: manual | parsed_content | extracted | whatsapp
model ProductFieldMeta {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  field       String
  confidence  Float
  source      String
  confirmedAt DateTime?

  @@unique([productId, field])
}

// Ürün fotoğrafları: position 0 kapak. Sıralar her zaman 0..n-1 (bkz.
// replaceProductImages). imageUrl base64 data URL; liste yanıtlarında dönmez.
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  position  Int
  imageUrl  String
  createdAt DateTime @default(now())

  @@unique([productId, position])
}

model ProductFavorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId, createdAt])
}

// "Son bakılan ürünler": kullanıcı-ürün başına tek satır, her bakışta viewedAt
// güncellenir; kullanıcı başına en fazla MAX_RECENT_VIEWS satır tutulur.
model ProductView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId, viewedAt])
}

model SampleRequest {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  requesterId  String
  requester    User     @relation(fields: [requesterId], references: [id])
  deliveryMode String   @default("seller_ships")
  note         String   @default("")
  status       String   @default("talep_edildi")
  createdAt    DateTime @default(now())

  events SampleRequestEvent[]

  /// @deprecated Eski serbest metin teslimat tercihi. Yerini deliveryMode + note
  /// aldı; yeni kayıtlarda boş kalıyor, hiçbir yerde okunmuyor. Ayrı bir temizlik
  /// migration'ında silinecek.
  deliveryPreference String @default("")

  @@index([productId])
}

// Numune talebinin geçmişi: her adımı KİMİN, NE ZAMAN yaptığı.
// Değişmezler:
// - Sadece eklenir (append-only), hiçbir zaman güncellenmez/silinmez.
// - Bir adımın TAMAMLANMIŞ sayılması SampleRequest.status'tan türetilir, olay
//   kaydının varlığından değil. Olaylar adımı yalnızca zenginleştirir (aktör,
//   zaman, not) — böylece geçmişi eksik eski kayıtlarda bile zaman çizelgesi
//   listedeki statü ile çelişmez.
model SampleRequestEvent {
  id              String        @id @default(cuid())
  sampleRequestId String
  sampleRequest   SampleRequest @relation(fields: [sampleRequestId], references: [id], onDelete: Cascade)
  status          String
  actorId         String
  actor           User          @relation(fields: [actorId], references: [id])
  note            String        @default("")
  createdAt       DateTime      @default(now())

  @@index([sampleRequestId, createdAt])
}

// Telefon doğrulama kodları: hem yeni kayıtta hem girişte kullanılan tek OTP akışı.
// codeHash = HMAC-SHA256(JWT_SECRET, phone + code) — düz kodun DB'de tutulmaması için.
model PhoneOtp {
  id        String   @id @default(cuid())
  phone     String   @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

// Mesajlaşma değişmezleri (Conversation / Message):
// - userAId her zaman userBId'den küçüktür (string karşılaştırması). Böylece iki
//   kişi arasındaki sohbet tek bir kayıtla, tek sorguda deterministik bulunur.
// - Okunmamış mesaj = senderId != ben && readAt == null.
// - Sohbet başlatmak ve mesaj göndermek için karşılıklı kabul edilmiş bir
//   Connection gerekir; okumak için gerekmez (ileride bağlantı kaldırılırsa geçmiş
//   kaybolmasın diye).
// - Gerçek zamanlılık şimdilik polling ile (4sn sohbet, 15sn liste). WebSocket'e
//   geçilecekse index.ts'teki app.listen -> http.createServer(app) dönüşümü gerekir.
model Conversation {
  id            String    @id @default(cuid())
  userAId       String
  userA         User      @relation("ConversationUserA", fields: [userAId], references: [id])
  userBId       String
  userB         User      @relation("ConversationUserB", fields: [userBId], references: [id])
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  messages      Message[]

  @@unique([userAId, userBId])
  @@index([userBId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String
  // Teklif kartı mesajı: doluysa istemci mesajı karta çevirir (ilişki yok; tablo yeniden kurulmasın).
  quoteRequestId String?
  createdAt      DateTime     @default(now())
  readAt         DateTime?

  @@index([conversationId, createdAt])
}

// İçerik akışı (Post / PostLike / PostComment) değişmezleri:
// - Akışta bir gönderi görünür: visibility "public" ise herkese, "connections" ise
//   sadece yazarın kabul edilmiş bağlantılarına (ve yazarın kendisine).
// - imageUrl, Product.imageUrl ile aynı biçimde base64 data URL tutar. LİSTE
//   yanıtlarında ASLA dönmez (bir sayfa yüzlerce KB'lık fotoğrafla megabaytlara
//   çıkardı) — liste hasImage:true der, istemci GET /api/posts/:id/image ile tek
//   tek çeker ve önbelleğe alır.
// - productId sadece yazarın kendi firmasının ürününü gösterebilir (başkasının
//   ürününü kendi gönderisine iliştirip talep toplamasın diye). Ürün silinirse
//   SetNull ile boşalır, gönderi ayakta kalır.
model Post {
  id         String        @id @default(cuid())
  authorId   String
  author     User          @relation(fields: [authorId], references: [id])
  body       String        @default("")
  imageUrl   String?
  productId  String?
  product    Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  visibility String        @default("public")
  // Bir gönderide ya fotoğraf ya video olur, ikisi birden olmaz (API'de zorunlu).
  videoId    String?       @unique
  video      Video?        @relation(fields: [videoId], references: [id], onDelete: SetNull)
  createdAt  DateTime      @default(now())
  // Yazar yazıyı/görünürlüğü/ürünü değiştirince dolar; akışta "düzenlendi"
  // gösterilir (alıcı metnin sonradan değiştiğini bilsin). Fotoğraf ve video
  // düzenlenemez.
  editedAt   DateTime?
  likes      PostLike[]
  comments   PostComment[]

  @@index([createdAt])
  @@index([authorId, createdAt])
  @@index([productId])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
}

// Videolar (Cloudflare Stream) değişmezleri:
// - Dosyanın kendisi bizde değil Cloudflare'de durur; telefon doğrudan
//   Cloudflare'e yükler (tek kullanımlık adres), sunucu 100 MB'lık dosyayı
//   hiç görmez. Burada yalnızca kimin olduğu ve işlenme durumu tutulur.
// - Her video Stream'de requireSignedURLs ile GİZLİ yüklenir. İzleme adresi
//   yalnızca GET /api/videos/:id/playback'ten, izleyicinin videonun bağlı olduğu
//   içeriği görme hakkı doğrulandıktan sonra, 1 saatlik anahtarla verilir.
// - streamUid istemciye asla dönmez.
// - Durum "processing"ten "ready"ye webhook olmadan da geçer: yerel geliştirmede
//   Cloudflare sunucumuza ulaşamadığı için okuma uçları bekleyen videoları
//   Stream'den tazeler (bkz. src/videos.ts).
model Video {
  id              String    @id @default(cuid())
  ownerId         String
  owner           User      @relation(fields: [ownerId], references: [id])
  streamUid       String    @unique
  status          String    @default("uploading")
  durationSeconds Float?
  errorReason     String    @default("")
  // customer-XXXX.cloudflarestream.com — video hazır olunca Stream'in HLS
  // adresinden öğreniliyor, oynatma adresini kurmak için gerekli.
  playbackHost    String    @default("")
  createdAt       DateTime  @default(now())
  readyAt         DateTime?
  post            Post?

  @@index([ownerId, createdAt])
}

// status: "pending" | "accepted" — reddetme bir statü değil, satırın silinmesiyle
// yapılır (iki kişi daha sonra tekrar bağlantı isteği gönderebilsin diye).
model Connection {
  id          String    @id @default(cuid())
  requesterId String
  requester   User      @relation("ConnectionRequester", fields: [requesterId], references: [id])
  addresseeId String
  addressee   User      @relation("ConnectionAddressee", fields: [addresseeId], references: [id])
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
}

// --- Firma asistanı (Faz 1, Adım 5; docs/faz1-plani.md) ---
// Sohbet kaydı sunucuda: araç çağrıları ve sonuçları geçmişin parçası, istemci
// yalnızca threadId tutar; WhatsApp kanalında istemci yok.
model AssistantThread {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  // "app" | "whatsapp" | "buyer" (Faz 2 Adım 3: alıcı, targetCompanyId firmasının asistanıyla konuşur)
  channel   String   @default("app")
  targetCompanyId String?
  // İlk sorudan türetilen kısa başlık (liste için).
  title     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  AssistantMessage[]

  @@index([userId, updatedAt])
}

model AssistantMessage {
  id        String          @id @default(cuid())
  threadId  String
  thread    AssistantThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  // "user" | "assistant"
  role      String
  // Ekrana giden içerik: { text, toolCalls: [{ name, title, input, output, summary }], memorySuggestions: [{ key, value, reason }] }
  contentJson String
  // Modele giden/gelen ham mesajlar (tool_use / tool_result dahil); sonraki
  // turda geçmiş buradan kurulur. JSON dizi metni.
  apiJson   String          @default("[]")
  createdAt DateTime        @default(now())

  @@index([threadId, createdAt])
}

// Firma hafızası: kur, fason ücreti, fire gibi firmanın kendi varsayılanları.
// Asistan okur ve ÖNERİR; yazma yalnızca kullanıcı onayıyla (PUT /assistant/memory/:key).
model CompanyMemory {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  key       String
  // JSON değer metni (sayı, metin ya da nesne).
  valueJson String
  updatedAt DateTime @updatedAt

  @@unique([companyId, key])
}

// Gelen WhatsApp mesajları (Faz 1, Adım 7): tekrar koruması (messageId) ve
// denetim kaydı. status: received | answered | unknown_user | non_text |
// assistant_unavailable | failed | send_failed.
model WhatsAppInbound {
  id          String    @id @default(cuid())
  messageId   String    @unique
  fromPhone   String
  type        String    @default("text")
  body        String    @default("")
  status      String    @default("received")
  replyBody   String    @default("")
  error       String    @default("")
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  threadId    String?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([fromPhone, receivedAt])
}

// --- Faz 2, Adım 1: bildirimler ve akış izleme (docs/faz2-plani.md) ---
// kind: sample_request_new | sample_request_status | connection_request | watch_match | quote_* (Adım 2)
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  body      String    @default("")
  // Ekranın nereye gideceği: { productId?, sampleRequestId?, userId?, ruleId?, postId? }
  dataJson  String    @default("{}")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// "Bu kalitede ürün çıkınca haber ver": queryJson = watch.ts watchQuerySchema (ürün süzgecinin alt kümesi).
model WatchRule {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  queryJson     String
  active        Boolean      @default(true)
  lastMatchedAt DateTime?
  createdAt     DateTime     @default(now())
  matches       WatchMatch[]

  @@index([userId])
}

// Aynı ürün aynı kural için iki kez bildirilmesin.
model WatchMatch {
  id        String    @id @default(cuid())
  ruleId    String
  rule      WatchRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  productId String
  createdAt DateTime  @default(now())

  @@unique([ruleId, productId])
}

// --- Faz 2, Adım 2: teklif akışı (docs/faz2-plani.md) ---
// Bağlantı şartı yok (Fırat 2026-09-17). Fiyat yalnızca taraflara görünür.
// status: open (teklif bekliyor) | quoted | accepted | declined | cancelled
model QuoteRequest {
  id              String    @id @default(cuid())
  buyerId         String
  buyer           User      @relation(fields: [buyerId], references: [id])
  // Alıcının firması (varsa) ve satıcı firma, istek anındaki değerler.
  buyerCompanyId  String?
  sellerCompanyId String
  productId       String
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity        Float
  // "m" | "kg"
  unit            String
  targetDate      DateTime?
  note            String    @default("")
  status          String    @default("open")
  // Faz 3 Adım 1: çoklu teklif isteğinin parçasıysa dolu (ilişki yok; tablo yeniden kurulmasın).
  // Satıcıya ASLA dönmez: satıcı kaç firmaya sorulduğunu bilmez.
  rfqId           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  quotes          Quote[]

  @@index([buyerId, createdAt])
  @@index([sellerCompanyId, status, createdAt])
  @@index([rfqId])
}

// Çoklu teklif isteği (Faz 3, Adım 1): alıcının aynı ihtiyaç için seçtiği ürünlere giden
// QuoteRequest'leri toplar; karşılaştırma tablosu bunun üzerinden kurulur.
model Rfq {
  id         String    @id @default(cuid())
  buyerId    String
  title      String
  quantity   Float
  unit       String
  targetDate DateTime?
  note       String    @default("")
  createdAt  DateTime  @default(now())

  @@index([buyerId, createdAt])
}

// Bir isteğe birden çok teklif sürümü olabilir; geçerli olan son "sent".
// status: draft | sent | accepted | declined | superseded
model Quote {
  id            String       @id @default(cuid())
  requestId     String
  request       QuoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sellerUserId  String
  sellerUser    User         @relation(fields: [sellerUserId], references: [id])
  priceValue    Float?
  priceCurrency String       @default("")
  // Fiyat birimi: "m" | "kg" (isteğin birimiyle aynı olması beklenir)
  priceUnit     String       @default("")
  moq           Float?
  moqUnit       String       @default("")
  leadTimeDays  Int?
  validUntil    DateTime?
  paymentTerms  String       @default("")
  note          String       @default("")
  status        String       @default("draft")
  sentAt        DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([requestId, createdAt])
}

// --- Faz 2, Adım 3: satıcı asistanı (alıcı sorularına katalogdan cevap) ---
// Firmanın sık sorulan soruları; satıcı asistanı bunları okur (fiyat yazılmaz).
model CompanyFaq {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

// Asistanın cevaplayamayıp satıcıya ilettiği soru. status: open | answered
model CompanyQuestion {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  askerId    String
  asker      User      @relation(fields: [askerId], references: [id])
  threadId   String?
  productId  String?
  question   String
  answer     String    @default("")
  status     String    @default("open")
  createdAt  DateTime  @default(now())
  answeredAt DateTime?

  @@index([companyId, status, createdAt])
  @@index([askerId, createdAt])
}

// --- Faz 2, Adım 5: makine parkı (parkur) ---
// Makine türü SERBEST METİN (Fırat 2026-09-17: tür çok, üretici yazar); kindKey aramada
// eşleşsin diye katlanmış hali. group: orme | dokuma | boya_terbiye | baski | konfeksiyon | iplik | diger
model Machine {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  group        String
  kind         String
  kindKey      String
  brand        String   @default("")
  model        String   @default("")
  year         Int?
  // Pus (çap, inç) ve fayn (incelik); örme dışında boş kalır.
  diameterInch Float?
  gauge        Float?
  feeders      Int?
  needles      Int?
  // Çalışma eni (cm): dokuma, raschel, ram vb.
  workingWidthCm Float?
  // Serbest özellik: tek plaka, çift plaka, jakar, elektronik...
  feature      String   @default("")
  count        Int      @default(1)
  note         String   @default("")
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId, position])
  @@index([group, kindKey])
  @@index([gauge, diameterInch])
}

// --- Faz 2, Adım 7: karşılıklı referans ---
// fromCompany, toCompany için "bizim <relation>'imiz" der; toCompany onaylarsa iki firmanın
// sayfasında görünür. relation: musteri | tedarikci. status: pending | confirmed | rejected
model CompanyReference {
  id            String   @id @default(cuid())
  fromCompanyId String
  fromCompany   Company  @relation("ReferenceFrom", fields: [fromCompanyId], references: [id], onDelete: Cascade)
  toCompanyId   String
  toCompany     Company  @relation("ReferenceTo", fields: [toCompanyId], references: [id], onDelete: Cascade)
  relation      String
  note          String   @default("")
  status        String   @default("pending")
  createdById   String
  createdAt     DateTime @default(now())
  respondedAt   DateTime?

  @@unique([fromCompanyId, toCompanyId, relation])
  @@index([toCompanyId, status])
}

// İplik dizini (Faz 2, Adım 6). İplik de bir Product satırıdır (type = "iplik";
// weightGsm/widthCm = 0) ki teklif, numune, favori, gönderi altyapısı aynen çalışsın.
// Karışım ProductComposition'da, sertifika ProductCertificate'ta tutulur.
model YarnSpec {
  productId     String  @id
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Ana alan (Fırat 2026-09-18): pamuk | viskon | polyester | naylon | akrilik | yun | keten | karisim | fantezi | elastan_gipe | diger
  family        String
  count         Float
  // ne | nm | tex | dtex | denye
  countUnit     String
  ply           Int     @default(1)
  // Tek katın dtex karşılığı: birimden bağımsız aralık araması için.
  countDtex     Float
  filaments     Int?
  // "" | ring | open_end | vortex | kompakt | siro
  spinning      String  @default("")
  // "" | karde | penye
  combing       String  @default("")
  // "" | dty | fdy | poy | aty | bcf | mono
  filamentType  String  @default("")
  // "" | parlak | yari_mat | mat
  luster        String  @default("")
  // "" | S | Z
  twistDirection String @default("")
  twistTpm      Float?
  // Kullanım yerleri: JSON dizi metni (yuvarlak_orme, triko, dokuma_cozgu, ...)
  endUses       String  @default("[]")
  // ham | boyali | melanj | elyaf_boyali | dope_dyed
  colorState    String  @default("")
  color         String  @default("")
  // Serbest çeşit adı: fantezi (şönil, buklet...), gipe yapısı vb.
  variety       String  @default("")
  origin        String  @default("")
  brand         String  @default("")
  coneWeightKg  Float?
  // tuccar ise üretici değil satıcı stoğu
  sellerRole    String  @default("")

  @@index([family])
  @@index([countDtex])
}

// Görünüm kartı (Faz 3, Adım 3): ürünün kapak fotoğrafından çıkarılan desen/renk/yüzey/doku/
// şeffaflık. imageHash kapak değişmedikçe modelin yeniden çağrılmasını önler.
model ProductLook {
  productId String   @id
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  lookJson  String
  imageHash String
  model     String
  updatedAt DateTime @updatedAt
}

// Fotoğrafla arama sayacı (kullanıcı başına günlük sınır; her arama bir model çağrısıdır).
model LookSearch {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Sipariş kaydı (Faz 3, Adım 4): kabul edilen tekliften doğar. Platform ödeme almaz, sevkiyat
// izlemez; yalnızca iki tarafın BEYANI tutulur. Ödeme konusuna hiç girilmez (Fırat kararı 2026-09-18).
// İlişkiler bilinçli olarak yok (mevcut tablolar yeniden kurulmasın); bütünlük uygulama katmanında.
model Deal {
  id                 String    @id @default(cuid())
  quoteRequestId     String    @unique
  quoteId            String
  buyerId            String
  buyerCompanyId     String?
  sellerCompanyId    String
  productId          String
  productCode        String
  quantity           Float
  unit               String
  // Satıcının kendi teklifindeki terminden hesaplanır (kabul tarihi + termin günü); yoksa alıcının istediği tarih.
  agreedDeliveryDate DateTime?
  // acik | teslim_bildirildi | teslim_edildi | itiraz | iptal
  status             String    @default("acik")
  sellerDeliveredAt  DateTime?
  buyerConfirmedAt   DateTime?
  disputeNote        String    @default("")
  cancelledByRole    String    @default("")
  cancelReason       String    @default("")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  reviews            DealReview[]

  @@index([buyerId, createdAt])
  @@index([sellerCompanyId, createdAt])
  @@index([buyerCompanyId])
}

// Karşılıklı değerlendirme: yalnızca teslimi tamamlanan işte, taraf başına bir kez.
// İki taraf da yazınca ya da teslimden 14 gün sonra görünür olur (misilleme puanını önlemek için).
model DealReview {
  id              String   @id @default(cuid())
  dealId          String
  deal            Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  // Yazan taraf: buyer | seller
  authorRole      String
  authorUserId    String
  // Değerlendirilen firma (alıcının firması yoksa boş).
  targetCompanyId String?
  // Alıcı → satıcı: quality, timing, communication. Satıcı → alıcı: communication, seriousness. 1-5.
  quality         Int?
  timing          Int?
  communication   Int
  seriousness     Int?
  comment         String   @default("")
  createdAt       DateTime @default(now())

  @@unique([dealId, authorRole])
  @@index([targetCompanyId])
}

// Kişisel profil fotoğrafı: ayrı tabloda, çünkü kullanıcı satırı pek çok yanıtta (oturum, gönderi
// yazarı, sohbet) tümüyle dönüyor; base64 fotoğraf o yanıtlara girmemeli (CompanyLogo ile aynı gerekçe).
model UserAvatar {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageUrl  String
  updatedAt DateTime @updatedAt
}

// WhatsApp'tan gönderilen etiket fotoğrafından hazırlanan ürün TASLAĞI. Ürün oluşturmaz: kullanıcı
// uygulamada taslağı açar, onay ekranında kontrol edip kaydeder. İlişki yok (mevcut tablolar yeniden kurulmasın).
model ProductDraft {
  id             String   @id @default(cuid())
  userId         String
  companyId      String
  // whatsapp
  source         String
  // Etiket fotoğrafı (data URL); ürün fotoğrafı olarak da önerilir.
  imageUrl       String
  caption        String   @default("")
  // skills/passportExtract sonucu (ExtractOutcome JSON)
  extractionJson String
  // new | used | dismissed
  status         String   @default("new")
  createdAt      DateTime @default(now())

  @@index([userId, status, createdAt])
}

// Davet (Faz 2, Adım 4). İlişki yok (mevcut tablolar yeniden kurulmasın); bütünlük uygulama katmanında.
model Invite {
  id               String    @id @default(cuid())
  code             String    @unique
  inviterId        String
  inviterCompanyId String?
  inviteeName      String    @default("")
  // Yazıldıysa (0XXXXXXXXXX): bu numara kayıt olunca doğrudan bağlantı kurulur.
  inviteePhone     String    @default("")
  // "" | tedarikci | musteri (davet edilenin, davet edene göre rolü)
  relation         String    @default("")
  note             String    @default("")
  // pending | joined | cancelled
  status           String    @default("pending")
  joinCount        Int       @default(0)
  joinedUserId     String?
  joinedAt         DateTime?
  createdAt        DateTime  @default(now())

  @@index([inviterId, createdAt])
  @@index([inviteePhone])
}

// Ürün sayfasına ve sohbet mesajına bağlanan videolar. Bir video tek bir yere bağlanır
// (gönderi, ürün ya da mesaj). İlişki yok: mevcut tablolar yeniden kurulmasın.
model VideoLink {
  id             String   @id @default(cuid())
  videoId        String   @unique
  productId      String?
  messageId      String?  @unique
  conversationId String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([productId, sortOrder])
  @@index([conversationId])
}

// Anlık bildirim abonelikleri (Web Push). Bir kullanıcının birden çok cihazı olabilir.
// İlişki yok: mevcut tablolar yeniden kurulmasın.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String    @default("")
  createdAt  DateTime  @default(now())
  lastSentAt DateTime?

  @@index([userId])
}

// Kişi profili (LinkedIn benzeri; Fırat 2026-09-22): başlık, konum, hakkında ve kapak fotoğrafı.
// Kapak fotoğrafı base64 data URL; profil yanıtında dönmez, /users/:id/cover ile alınır.
// İlişki yok: mevcut tablolar yeniden kurulmasın.
model UserProfile {
  userId         String    @id
  headline       String    @default("")
  location       String    @default("")
  about          String    @default("")
  coverImageUrl  String    @default("")
  coverUpdatedAt DateTime?
  updatedAt      DateTime  @updatedAt
}

// Deneyim satırları (görev, firma, tarih aralığı, konum, açıklama). endYear boş = devam ediyor.
model UserExperience {
  id          String   @id @default(cuid())
  userId      String
  title       String
  company     String
  startMonth  Int
  startYear   Int
  endMonth    Int?
  endYear     Int?
  location    String   @default("")
  description String   @default("")
  createdAt   DateTime @default(now())

  @@index([userId, startYear, startMonth])
}

// Firma doğrulama başvurusu (Fırat 2026-09-22): firma belge (vergi levhası vb.; fotoğraf ya da PDF,
// base64 data URL) yükler, durum "inceleniyor" olur, yönetici belgeyi görüp onaylar/reddeder.
// status: pending | approved | rejected. İlişki yok: mevcut tablolar yeniden kurulmasın.
model VerificationRequest {
  id          String    @id @default(cuid())
  companyId   String
  userId      String
  documentUrl String
  note        String    @default("")
  status      String    @default("pending")
  adminNote   String    @default("")
  createdAt   DateTime  @default(now())
  decidedAt   DateTime?

  @@index([companyId, createdAt])
  @@index([status, createdAt])
}
