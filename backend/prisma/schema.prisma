generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// accountType: "konfeksiyon" | "uretici" | "bireysel"
// verification: "dogrulanmamis" | "inceleniyor" | "dogrulanmis"
// product.type: "raschel" | "orme" | "dokuma" | "diger"
// sampleRequest.status: "talep_edildi" | "onaylandi" | "hazirlandi" | "teslim_edildi"
//   Son adımın ETİKETİ teslimat moduna göre değişir ("Teslim Edildi" / "Kurye
//   Teslim Aldı") ama STATÜ tektir — mod zaten deliveryMode'da saklı, ayrıca
//   statü olarak tutulsa iki alan birbiriyle çelişebilirdi.
// sampleRequest.deliveryMode: "seller_ships" | "customer_courier"
// post.visibility: "public" | "connections"
// video.status: "uploading" | "processing" | "ready" | "error"
// Enums are modeled as plain strings because the sqlite connector has no native enum type;
// valid values are enforced at the API layer with zod.

model Company {
  id                String    @id @default(cuid())
  name              String
  taxId             String
  about             String    @default("")
  contactEmail      String    @default("")
  contactPhone      String    @default("")
  productCategories String    @default("")
  verification      String    @default("dogrulanmamis")
  companyCode       String    @unique
  createdAt         DateTime  @default(now())
  users             User[]
  products          Product[]
}

model User {
  id                   String          @id @default(cuid())
  accountType          String
  position             String
  firstName            String
  lastName             String
  phone                String          @unique
  phoneVerified        Boolean         @default(false)
  isAdmin              Boolean         @default(false)
  companyId            String?
  company              Company?        @relation(fields: [companyId], references: [id])
  sampleRequests       SampleRequest[]
  sentConnections      Connection[]    @relation("ConnectionRequester")
  receivedConnections  Connection[]    @relation("ConnectionAddressee")
  conversationsAsUserA Conversation[]  @relation("ConversationUserA")
  conversationsAsUserB Conversation[]  @relation("ConversationUserB")
  messages             Message[]
  posts                Post[]
  postLikes            PostLike[]
  postComments         PostComment[]
  sampleRequestEvents  SampleRequestEvent[]
  videos               Video[]
  createdAt            DateTime        @default(now())
}

model Product {
  id             String          @id @default(cuid())
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id])
  code           String
  type           String
  stock          Int
  weightGsm      Int
  widthCm        Int
  content        String
  useArea        String
  imageUrl       String?
  sampleRequests SampleRequest[]
  posts          Post[]
  createdAt      DateTime        @default(now())
}

model SampleRequest {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  requesterId  String
  requester    User     @relation(fields: [requesterId], references: [id])
  deliveryMode String   @default("seller_ships")
  note         String   @default("")
  status       String   @default("talep_edildi")
  createdAt    DateTime @default(now())

  events SampleRequestEvent[]

  /// @deprecated Eski serbest metin teslimat tercihi. Yerini deliveryMode + note
  /// aldı; yeni kayıtlarda boş kalıyor, hiçbir yerde okunmuyor. Ayrı bir temizlik
  /// migration'ında silinecek.
  deliveryPreference String @default("")

  @@index([productId])
}

// Numune talebinin geçmişi: her adımı KİMİN, NE ZAMAN yaptığı.
// Değişmezler:
// - Sadece eklenir (append-only), hiçbir zaman güncellenmez/silinmez.
// - Bir adımın TAMAMLANMIŞ sayılması SampleRequest.status'tan türetilir, olay
//   kaydının varlığından değil. Olaylar adımı yalnızca zenginleştirir (aktör,
//   zaman, not) — böylece geçmişi eksik eski kayıtlarda bile zaman çizelgesi
//   listedeki statü ile çelişmez.
model SampleRequestEvent {
  id              String        @id @default(cuid())
  sampleRequestId String
  sampleRequest   SampleRequest @relation(fields: [sampleRequestId], references: [id], onDelete: Cascade)
  status          String
  actorId         String
  actor           User          @relation(fields: [actorId], references: [id])
  note            String        @default("")
  createdAt       DateTime      @default(now())

  @@index([sampleRequestId, createdAt])
}

// Telefon doğrulama kodları: hem yeni kayıtta hem girişte kullanılan tek OTP akışı.
// codeHash = HMAC-SHA256(JWT_SECRET, phone + code) — düz kodun DB'de tutulmaması için.
model PhoneOtp {
  id        String   @id @default(cuid())
  phone     String   @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

// Mesajlaşma değişmezleri (Conversation / Message):
// - userAId her zaman userBId'den küçüktür (string karşılaştırması). Böylece iki
//   kişi arasındaki sohbet tek bir kayıtla, tek sorguda deterministik bulunur.
// - Okunmamış mesaj = senderId != ben && readAt == null.
// - Sohbet başlatmak ve mesaj göndermek için karşılıklı kabul edilmiş bir
//   Connection gerekir; okumak için gerekmez (ileride bağlantı kaldırılırsa geçmiş
//   kaybolmasın diye).
// - Gerçek zamanlılık şimdilik polling ile (4sn sohbet, 15sn liste). WebSocket'e
//   geçilecekse index.ts'teki app.listen -> http.createServer(app) dönüşümü gerekir.
model Conversation {
  id            String    @id @default(cuid())
  userAId       String
  userA         User      @relation("ConversationUserA", fields: [userAId], references: [id])
  userBId       String
  userB         User      @relation("ConversationUserB", fields: [userBId], references: [id])
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  messages      Message[]

  @@unique([userAId, userBId])
  @@index([userBId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String
  createdAt      DateTime     @default(now())
  readAt         DateTime?

  @@index([conversationId, createdAt])
}

// İçerik akışı (Post / PostLike / PostComment) değişmezleri:
// - Akışta bir gönderi görünür: visibility "public" ise herkese, "connections" ise
//   sadece yazarın kabul edilmiş bağlantılarına (ve yazarın kendisine).
// - imageUrl, Product.imageUrl ile aynı biçimde base64 data URL tutar. LİSTE
//   yanıtlarında ASLA dönmez (bir sayfa yüzlerce KB'lık fotoğrafla megabaytlara
//   çıkardı) — liste hasImage:true der, istemci GET /api/posts/:id/image ile tek
//   tek çeker ve önbelleğe alır.
// - productId sadece yazarın kendi firmasının ürününü gösterebilir (başkasının
//   ürününü kendi gönderisine iliştirip talep toplamasın diye). Ürün silinirse
//   SetNull ile boşalır, gönderi ayakta kalır.
model Post {
  id         String        @id @default(cuid())
  authorId   String
  author     User          @relation(fields: [authorId], references: [id])
  body       String        @default("")
  imageUrl   String?
  productId  String?
  product    Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  visibility String        @default("public")
  // Bir gönderide ya fotoğraf ya video olur, ikisi birden olmaz (API'de zorunlu).
  videoId    String?       @unique
  video      Video?        @relation(fields: [videoId], references: [id], onDelete: SetNull)
  createdAt  DateTime      @default(now())
  likes      PostLike[]
  comments   PostComment[]

  @@index([createdAt])
  @@index([authorId, createdAt])
  @@index([productId])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
}

// Videolar (Cloudflare Stream) değişmezleri:
// - Dosyanın kendisi bizde değil Cloudflare'de durur; telefon doğrudan
//   Cloudflare'e yükler (tek kullanımlık adres), sunucu 100 MB'lık dosyayı
//   hiç görmez. Burada yalnızca kimin olduğu ve işlenme durumu tutulur.
// - Her video Stream'de requireSignedURLs ile GİZLİ yüklenir. İzleme adresi
//   yalnızca GET /api/videos/:id/playback'ten, izleyicinin videonun bağlı olduğu
//   içeriği görme hakkı doğrulandıktan sonra, 1 saatlik anahtarla verilir.
// - streamUid istemciye asla dönmez.
// - Durum "processing"ten "ready"ye webhook olmadan da geçer: yerel geliştirmede
//   Cloudflare sunucumuza ulaşamadığı için okuma uçları bekleyen videoları
//   Stream'den tazeler (bkz. src/videos.ts).
model Video {
  id              String    @id @default(cuid())
  ownerId         String
  owner           User      @relation(fields: [ownerId], references: [id])
  streamUid       String    @unique
  status          String    @default("uploading")
  durationSeconds Float?
  errorReason     String    @default("")
  // customer-XXXX.cloudflarestream.com — video hazır olunca Stream'in HLS
  // adresinden öğreniliyor, oynatma adresini kurmak için gerekli.
  playbackHost    String    @default("")
  createdAt       DateTime  @default(now())
  readyAt         DateTime?
  post            Post?

  @@index([ownerId, createdAt])
}

// status: "pending" | "accepted" — reddetme bir statü değil, satırın silinmesiyle
// yapılır (iki kişi daha sonra tekrar bağlantı isteği gönderebilsin diye).
model Connection {
  id          String    @id @default(cuid())
  requesterId String
  requester   User      @relation("ConnectionRequester", fields: [requesterId], references: [id])
  addresseeId String
  addressee   User      @relation("ConnectionAddressee", fields: [addresseeId], references: [id])
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
}
