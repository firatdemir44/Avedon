generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// accountType: "konfeksiyon" | "uretici" | "bireysel"
// verification: "dogrulanmamis" | "inceleniyor" | "dogrulanmis"
// product.type: "raschel" | "orme" | "dokuma" | "diger"
// sampleRequest.status: "talep_edildi" | "onaylandi" | "hazirlandi" | "teslim_edildi"
// Enums are modeled as plain strings because the sqlite connector has no native enum type;
// valid values are enforced at the API layer with zod.

model Company {
  id                String    @id @default(cuid())
  name              String
  taxId             String
  about             String    @default("")
  contactEmail      String    @default("")
  contactPhone      String    @default("")
  productCategories String    @default("")
  verification      String    @default("dogrulanmamis")
  companyCode       String    @unique
  createdAt         DateTime  @default(now())
  users             User[]
  products          Product[]
}

model User {
  id                   String          @id @default(cuid())
  accountType          String
  position             String
  firstName            String
  lastName             String
  phone                String          @unique
  phoneVerified        Boolean         @default(false)
  isAdmin              Boolean         @default(false)
  companyId            String?
  company              Company?        @relation(fields: [companyId], references: [id])
  sampleRequests       SampleRequest[]
  sentConnections      Connection[]    @relation("ConnectionRequester")
  receivedConnections  Connection[]    @relation("ConnectionAddressee")
  conversationsAsUserA Conversation[]  @relation("ConversationUserA")
  conversationsAsUserB Conversation[]  @relation("ConversationUserB")
  messages             Message[]
  createdAt            DateTime        @default(now())
}

model Product {
  id             String          @id @default(cuid())
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id])
  code           String
  type           String
  stock          Int
  weightGsm      Int
  widthCm        Int
  content        String
  useArea        String
  imageUrl       String?
  sampleRequests SampleRequest[]
  createdAt      DateTime        @default(now())
}

model SampleRequest {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id])
  requesterId        String
  requester          User     @relation(fields: [requesterId], references: [id])
  deliveryPreference String
  status             String   @default("talep_edildi")
  createdAt          DateTime @default(now())
}

// Telefon doğrulama kodları: hem yeni kayıtta hem girişte kullanılan tek OTP akışı.
// codeHash = HMAC-SHA256(JWT_SECRET, phone + code) — düz kodun DB'de tutulmaması için.
model PhoneOtp {
  id        String   @id @default(cuid())
  phone     String   @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

// Mesajlaşma değişmezleri (Conversation / Message):
// - userAId her zaman userBId'den küçüktür (string karşılaştırması). Böylece iki
//   kişi arasındaki sohbet tek bir kayıtla, tek sorguda deterministik bulunur.
// - Okunmamış mesaj = senderId != ben && readAt == null.
// - Sohbet başlatmak ve mesaj göndermek için karşılıklı kabul edilmiş bir
//   Connection gerekir; okumak için gerekmez (ileride bağlantı kaldırılırsa geçmiş
//   kaybolmasın diye).
// - Gerçek zamanlılık şimdilik polling ile (4sn sohbet, 15sn liste). WebSocket'e
//   geçilecekse index.ts'teki app.listen -> http.createServer(app) dönüşümü gerekir.
model Conversation {
  id            String    @id @default(cuid())
  userAId       String
  userA         User      @relation("ConversationUserA", fields: [userAId], references: [id])
  userBId       String
  userB         User      @relation("ConversationUserB", fields: [userBId], references: [id])
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  messages      Message[]

  @@unique([userAId, userBId])
  @@index([userBId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String
  createdAt      DateTime     @default(now())
  readAt         DateTime?

  @@index([conversationId, createdAt])
}

// status: "pending" | "accepted" — reddetme bir statü değil, satırın silinmesiyle
// yapılır (iki kişi daha sonra tekrar bağlantı isteği gönderebilsin diye).
model Connection {
  id          String    @id @default(cuid())
  requesterId String
  requester   User      @relation("ConnectionRequester", fields: [requesterId], references: [id])
  addresseeId String
  addressee   User      @relation("ConnectionAddressee", fields: [addresseeId], references: [id])
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
}
