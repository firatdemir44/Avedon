    "check:formulas": "tsx scripts/check-formulas.ts",
    "texart:test": "tsx scripts/texart-testset.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@prisma/client": "^6.3.0",
    "@types/qrcode": "^1.5.6",
