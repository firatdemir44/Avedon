# Bu dosyayı kopyalayıp adını ".env" yapın ve değerleri doldurun.
# .env git'e GİRMEZ (her makinede ayrı); gizli anahtarları asla sohbete veya
# git'e yazmayın. Diğer bilgisayardaki değerleri USB / şifre yöneticisiyle taşıyın.

# Yerel SQLite veritabanı (prisma/dev.db). Her makinede ayrı dosya.
DATABASE_URL="file:./dev.db"

# Oturum jetonlarını imzalayan gizli dize (uzun, rastgele). Makineye özel olabilir;
# yalnızca o makinede açılan oturumlar geçerli olur.
JWT_SECRET=

# İsteğe bağlı sunucu portu (boşsa 4000).
# PORT=4000

# AI Danışman, Görsel Maliyet ve "Etiketten doldur" (pasaport çıkarımı) için Anthropic
# anahtarı. Boşsa bu özellikler kapalı (uçlar 503 döner).
ANTHROPIC_API_KEY=
# Testler için: 1 ise gerçek model çağrılmaz, pasaport çıkarımı sahte (deterministik) yanıt
# üretir. Canlıda BOŞ bırakın.
# ANTHROPIC_MOCK=

# Video (Cloudflare Stream). Boşsa uygulamada video düğmesi "henüz etkinleştirilmedi" der.
# Account ID: Cloudflare paneli adres çubuğundaki 32 karakterlik dizi.
# Token: "Read and write to Cloudflare Stream and Images" şablonuyla oluşturulan anahtar.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
# Asistana sesli soru (Whisper, Workers AI). Cloudflare > Workers AI > Use REST API > Create a Workers AI API Token
CLOUDFLARE_AI_TOKEN=

# WhatsApp bildirimleri (isteğe bağlı; boşsa bildirim gönderilmez).
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_VERIFY_TOKEN=
# Meta uygulama gizli anahtarı (App Dashboard > App settings > Basic > App secret): gelen webhook
# imzası bununla doğrulanır. Canlıda boş bırakılmamalı; boşsa imza doğrulanmaz (yalnızca uyarı).
# WHATSAPP_APP_SECRET=
# WhatsApp Business account ID (gizli değil; Meta panelinde test numarasının altında). Tanımlıysa
# sunucu açılışta uygulamayı bu hesaba abone eder; sonucu /api/health whatsapp.wabaSubscription gösterir.
# WHATSAPP_WABA_ID=
# Testler için: 1 ise Graph API çağrılmaz, giden mesajlar bellekte tutulur. Canlıda BOŞ bırakın.
# WHATSAPP_MOCK=

# SMS ile doğrulama kodu (İleti Merkezi). Boşsa kod yalnızca sunucu kaydına düşer.
# SMS_PROVIDER=iletimerkezi
# ILETIMERKEZI_KEY=
# ILETIMERKEZI_SECRET=
# ILETIMERKEZI_SENDER=
# ILETIMERKEZI_HASH=   (panel "API Hash" veriyorsa SECRET yerine bunu girin)
