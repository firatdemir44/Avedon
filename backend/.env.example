# Bu dosyayı kopyalayıp adını ".env" yapın ve değerleri doldurun.
# .env git'e GİRMEZ (her makinede ayrı); gizli anahtarları asla sohbete veya
# git'e yazmayın. Diğer bilgisayardaki değerleri USB / şifre yöneticisiyle taşıyın.

# Yerel SQLite veritabanı (prisma/dev.db). Her makinede ayrı dosya.
DATABASE_URL="file:./dev.db"

# Oturum jetonlarını imzalayan gizli dize (uzun, rastgele). Makineye özel olabilir;
# yalnızca o makinede açılan oturumlar geçerli olur.
JWT_SECRET=

# İsteğe bağlı sunucu portu (boşsa 4000).
# PORT=4000

# AI Danışman ve Görsel Maliyet için Anthropic anahtarı. Boşsa bu iki özellik kapalı.
ANTHROPIC_API_KEY=

# Video (Cloudflare Stream). Boşsa uygulamada video düğmesi "henüz etkinleştirilmedi" der.
# Account ID: Cloudflare paneli adres çubuğundaki 32 karakterlik dizi.
# Token: "Read and write to Cloudflare Stream and Images" şablonuyla oluşturulan anahtar.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=

# WhatsApp bildirimleri (isteğe bağlı; boşsa bildirim gönderilmez).
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_VERIFY_TOKEN=
